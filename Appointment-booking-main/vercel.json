{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/concierge",
      "destination": "/api/concierge"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
