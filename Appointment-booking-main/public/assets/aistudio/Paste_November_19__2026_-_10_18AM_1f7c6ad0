    const fieldName = document.getElementById('field-name');
    const fieldConfirm = document.getElementById('field-confirm');
    const fieldTerms = document.getElementById('field-terms');
    const pwdMeterWrapper = document.getElementById('pwd-meter-wrapper');
    const forgotPassword = document.getElementById('forgot-password');
    const btnLabel = document.getElementById('btn-label');
    const pwdInput = document.getElementById('password');
    const togglePwdBtn = document.getElementById('toggle-pwd-btn');
    const eyeIcon = document.getElementById('eye-icon');

    let isSignUp = true;

    function renderMode(signUpMode) {
      isSignUp = signUpMode;
      if (isSignUp) {
        tabSignup.className = 'py-2.5 px-3 rounded-lg bg-surface-container-lowest text-primary font-label-lg text-label-lg shadow-sm transition-all duration-200 flex items-center justify-center gap-1.5';
        tabLogin.className = 'py-2.5 px-3 rounded-lg text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-1.5';
        viewTitle.textContent = 'Create your account';
        viewSubtitle.textContent = 'Join thousands booking seamless appointments every day.';
        fieldName.classList.remove('hidden');
        fieldConfirm.classList.remove('hidden');
        fieldTerms.classList.remove('hidden');
        pwdMeterWrapper.classList.remove('hidden');
        forgotPassword.classList.add('hidden');
        btnLabel.textContent = 'Create Free Account';
        footerText.innerHTML = 'Already have an account? <button type="button" id="footer-toggle" class="text-primary font-semibold hover:underline ml-1">Log In</button>';
      } else {
        tabLogin.className = 'py-2.5 px-3 rounded-lg bg-surface-container-lowest text-primary font-label-lg text-label-lg shadow-sm transition-all duration-200 flex items-center justify-center gap-1.5';
        tabSignup.className = 'py-2.5 px-3 rounded-lg text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-1.5';
        viewTitle.textContent = 'Welcome back';
        viewSubtitle.textContent = 'Access your booked appointments and schedule settings.';
        fieldName.classList.add('hidden');
        fieldConfirm.classList.add('hidden');
        fieldTerms.classList.add('hidden');
        pwdMeterWrapper.classList.add('hidden');
        forgotPassword.classList.remove('hidden');
        btnLabel.textContent = 'Sign In to SlotWise';
        footerText.innerHTML = "Don't have an account yet? <button type="button" id="footer-toggle" class="text-primary font-semibold hover:underline ml-1">Sign Up</button>";
      }
      
      const newToggle = document.getElementById('footer-toggle');
      if (newToggle) {
        newToggle.addEventListener('click', () => renderMode(!isSignUp));
      }
    }

    tabSignup.addEventListener('click', () => renderMode(true));
    tabLogin.addEventListener('click', () => renderMode(false));
    footerToggle.addEventListener('click', () => renderMode(false));

    togglePwdBtn.addEventListener('click', () => {
      const isPassword = pwdInput.type === 'password';
      pwdInput.type = isPassword ? 'text' : 'password';
      eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
    });
