<script>
    let currentSelectedDate = 'Today, Oct 18';
    let currentSelectedSlot = '03:30 PM';
    let currentPrice = '$55';
    let currentServiceName = 'Signature Haircut';

    function updateSummary() {
      const dtElement = document.getElementById('summary-date-time');
      const priceElement = document.getElementById('summary-price');
      const titleElement = document.getElementById('summary-title');
      if (dtElement) dtElement.innerText = currentSelectedDate + ' • ' + currentSelectedSlot;
      if (priceElement) priceElement.innerText = currentPrice;
      if (titleElement) titleElement.innerText = ' • ' + currentServiceName;
    }

    function selectSlot(el, slotTime) {
      document.querySelectorAll('.time-slot-btn').forEach(btn => {
        btn.className = "time-slot-btn py-3 px-2 rounded-xl bg-surface-container text-primary font-label-md text-label-md font-bold shadow-sm hover:bg-surface-container-highest active:scale-95 transition-all flex items-center justify-center";
        btn.innerHTML = slotTime === btn.innerText.trim() ? btn.innerText.trim() : btn.innerText.replace('check_circle', '').trim();
      });

      el.className = "time-slot-btn py-3 px-2 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md active:scale-95 transition-all flex items-center justify-center gap-1.5 ring-2 ring-primary ring-offset-1";
      el.innerHTML = `<span>${slotTime}</span><span class="material-symbols-outlined text-secondary-fixed text-[16px]">check_circle</span>`;

      currentSelectedSlot = slotTime;
      updateSummary();
    }

    function selectDate(el, dateText) {
      document.querySelectorAll('.date-chip').forEach(chip => {
        chip.className = "date-chip flex flex-col items-center py-2.5 px-1 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm transition-all active:scale-95";
        const dayLabel = chip.querySelector('span:first-child');
        if (dayLabel) {
          dayLabel.className = "font-label-sm text-label-sm text-on-surface-variant";
        }
        const badge = chip.querySelector('span:nth-child(3)');
        if (badge) badge.remove();
      });

      el.className = "date-chip flex flex-col items-center py-2.5 px-1 rounded-xl bg-primary text-on-primary shadow-md transition-all active:scale-95 relative ring-offset-2";
      const dayLabel = el.querySelector('span:first-child');
      if (dayLabel) {
        dayLabel.className = "font-label-sm text-label-sm text-on-primary-container font-semibold";
      }

      currentSelectedDate = dateText;
      updateSummary();
    }

    function selectService(el, serviceName, price, duration) {
      document.querySelectorAll('.service-chip').forEach(card => {
        card.className = "service-chip flex-shrink-0 w-64 p-space-md rounded-xl text-left transition-all relative overflow-hidden bg-surface-container-lowest text-on-surface shadow-sm";
        const iconContainer = card.querySelector('div:first-child div:first-child');
        if (iconContainer) iconContainer.className = "w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-primary";
        const title = card.querySelector('p');
        if (title) title.className = "font-label-lg text-label-lg font-bold text-on-surface line-clamp-1";
        const priceTxt = card.querySelector('div:first-child span:last-child');
        if (priceTxt) priceTxt.className = "font-headline-sm text-headline-sm font-bold text-on-surface";
        const watermark = card.querySelector('div:last-child');
        if (watermark && watermark.classList.contains('pointer-events-none')) watermark.remove();
      });

      el.className = "service-chip flex-shrink-0 w-64 p-space-md rounded-xl text-left transition-all relative overflow-hidden bg-primary-container text-on-primary shadow-md";
      const iconCont = el.querySelector('div:first-child div:first-child');
      if (iconCont) iconCont.className = "w-8 h-8 rounded-lg bg-surface-container-lowest/20 flex items-center justify-center text-white";
      const pTitle = el.querySelector('p');
      if (pTitle) pTitle.className = "font-label-lg text-label-lg font-bold text-white line-clamp-1";
      const pPrice = el.querySelector('div:first-child span:last-child');
      if (pPrice) pPrice.className = "font-headline-sm text-headline-sm font-bold text-white";

      currentPrice = price;
      currentServiceName = serviceName.split(' ')[0] + ' ' + (serviceName.split(' ')[1] || '');
      updateSummary();
    }

    function triggerBookingConfirmation() {
      const btn = document.getElementById('book-btn');
      btn.innerHTML = `<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Securing...</span>`;
      setTimeout(() => {
        btn.className = "flex-shrink-0 flex items-center gap-2 px-space-md py-3 rounded-xl bg-secondary text-on-secondary font-label-lg text-label-lg font-semibold shadow-md active:scale-95 transition-all";
        btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">done</span><span>Confirmed!</span>`;
      }, 700);
    }

    const favBtn = document.getElementById('fav-btn');
    if (favBtn) {
      favBtn.addEventListener('click', () => {
        const icon = document.getElementById('fav-icon');
        if (icon.innerText === 'favorite_border') {
          icon.innerText = 'favorite';
          icon.style.fontVariationSettings = "'FILL' 1";
          favBtn.classList.add('text-error');
        } else {
          icon.innerText = 'favorite_border';
          icon.style.fontVariationSettings = "'FILL' 0";
          favBtn.classList.remove('text-error');
        }
      });
    }
